{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaper.hupu.io/timeflow/schema/batch-report.schema.json",
  "title": "BatchReport",
  "description": "批量上报请求与逐条结果（design §10.3）。批量超限整体拒绝；条目部分成功是正常语义。",
  "$defs": {
    "StreamBatchRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "allOf": [
              {"$ref": "stream-update.schema.json"},
              {"type": "object", "required": ["streamKey", "value", "expectedVersion", "requestId"]}
            ]
          }
        }
      }
    },
    "WindowBatchRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "window-report.schema.json"}
        }
      }
    },
    "PointBatchRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "point-report.schema.json"}
        }
      }
    },
    "CrossEventBatchRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["eventId", "sourceType", "sourceId", "targetType", "targetId", "point"],
            "properties": {
              "eventId": {"type": "string", "minLength": 1, "maxLength": 64},
              "sourceType": {"type": "string", "minLength": 1, "maxLength": 32},
              "sourceId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
              "targetType": {"type": "string", "minLength": 1, "maxLength": 32},
              "targetId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
              "point": {"$ref": "point-report.schema.json"}
            }
          }
        }
      }
    },
    "BatchItemResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "idempotencyKind", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "idempotencyKind": {"type": "string", "enum": ["requestId", "eventId"]},
        "status": {"type": "string", "enum": ["accepted", "replayed", "rejected"]},
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "maxLength": 512},
        "retryable": {"type": "boolean"},
        "replayed": {"type": "boolean"},
        "details": {"type": "object", "additionalProperties": true}
      }
    },
    "BatchResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["results", "accepted", "rejected"],
      "properties": {
        "results": {
          "type": "array",
          "items": {"$ref": "#/$defs/BatchItemResult"}
        },
        "accepted": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/StreamBatchRequest"},
    {"$ref": "#/$defs/WindowBatchRequest"},
    {"$ref": "#/$defs/PointBatchRequest"},
    {"$ref": "#/$defs/CrossEventBatchRequest"},
    {"$ref": "#/$defs/BatchResult"}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaper.hupu.io/timeflow/schema/change-event.schema.json",
  "title": "SequenceChangeEventV1",
  "description": "Immutable, canonical change fact produced by one completed settlement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventKind",
    "workspaceId",
    "settlementId",
    "scope",
    "interval",
    "definitionVersion",
    "ruleVersions",
    "changes",
    "createdAt",
    "changesDigest",
    "eventDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "pattern": "^cev_[0-9a-f]{32}$"},
    "eventKind": {"type": "string", "minLength": 1, "maxLength": 128},
    "workspaceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "settlementId": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"$ref": "#/$defs/scope"},
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "integer", "minimum": 0},
        "to": {"type": "integer", "minimum": 0}
      }
    },
    "definitionVersion": {"type": "integer", "minimum": 1},
    "ruleVersions": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/change"}
    },
    "createdAt": {"type": "integer", "minimum": 0},
    "changesDigest": {"$ref": "#/$defs/digest"},
    "eventDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeId",
        "target",
        "metricId",
        "precision",
        "delta",
        "produced",
        "capped",
        "sourceStreamKeys"
      ],
      "properties": {
        "changeId": {"type": "string", "pattern": "^chg_[0-9a-f]{32}$"},
        "target": {"$ref": "#/$defs/scope"},
        "metricId": {"type": "string", "minLength": 1, "maxLength": 128},
        "precision": {"type": "integer", "minimum": 0, "maximum": 6},
        "delta": {"$ref": "#/$defs/decimal"},
        "produced": {"$ref": "#/$defs/decimal"},
        "capped": {"$ref": "#/$defs/decimal"},
        "sourceStreamKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
